[push]
	default = current
	autoSetupRemote = true

[pull]
	default = current

[rebase]
	autoStash = true

[core]
	editor       = hx
	excludesfile = ~/.gitignore
	pager        = less -F -X

[alias]
	br   = branch
	can  = "commit --amend --no-edit"
	ch   = checkout
	main = !br=$(git default-branch) && remote=$(git remote get-url upstream >/dev/null 2>&1 && echo upstream || echo origin) && git checkout \"$br\" && git pull \"$remote\" \"$br\" && git pr
	st   = status
    tr   = "log --graph --decorate --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative"

[color]
	branch = auto
	diff   = auto
	pager  = true
	status = auto
	ui     = true

[color "diff"]
	frag = magenta bold
	old  = red bold
	new  = green bold

[color "status"]
	changed   = yellow

[user]
	name  = Hwasung Lee
	email = hwasung_lee@apple.com

[credential]
	helper = cache

[pager]
	branch = false
	grep   = false

[checkout]
	defaultRemote = origin

# Machine specific settings live here, untracked, so a path or credential that only makes sense on
# one machine never lands in the repo. Last include wins, so keep this at the end.
[include]
	path = ~/.gitconfig.local
