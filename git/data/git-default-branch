#!/usr/bin/env python3
"""Print the default branch of the current repo: `main` or `master`.

Detection order:
  1. `git symbolic-ref refs/remotes/origin/HEAD` (set by clone, authoritative)
  2. local branch existence: prefer `main`, fall back to `master`

Exits non-zero if neither can be determined.
"""

import subprocess
import sys


def detect() -> str:
    # Authoritative: origin/HEAD points at the default branch on the remote.
    try:
        ref = subprocess.run(
            ["git", "symbolic-ref", "refs/remotes/origin/HEAD"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
        # ref is like "refs/remotes/origin/main"
        return ref.rsplit("/", 1)[-1]
    except subprocess.CalledProcessError:
        pass

    # Fallback: whichever conventional name exists locally.
    for candidate in ("main", "master"):
        if (
            subprocess.run(
                ["git", "rev-parse", "--verify", "--quiet", candidate],
                capture_output=True,
            ).returncode
            == 0
        ):
            return candidate

    print("git default-branch: could not detect default branch", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    print(detect())
