# -*- coding: utf8 -*-

"""Prune git branches both remote and local."""

__author__ = "Hwasung Lee"


import subprocess
import shlex
import re
import logging
import typing as t


logging.basicConfig(level=logging.INFO)
LOGGER = logging.getLogger(__file__)


def run_then_split(cmd):
    """Command to execute and split the result of."""
    try:
        lines = subprocess.run(shlex.split(cmd), capture_output=True, text=True, check=True).stdout.strip().split("\n")
        return [l.strip() for l in lines if l]
    except Exception as e:
        LOGGER.exception("Failed running command: %s\n%s", cmd, p.stderr)
        raise e


LOGGER.info("Pruning local branches that are merged.")
for branch in run_then_split("git branch --merged"):
    # If it is the current branch or `main` we skip the branch.
    if branch.startswith("*") or branch == "main":
        continue

    LOGGER.info("  Deleting branch: %s", branch)
    subprocess.run(["git", "branch", "--delete", branch], check=True)

LOGGER.info("Pruning local branches that have no diff.")
for branch in run_then_split("git branch --no-merged"):
    # If it is the current branch or `main` we skip the branch.
    if branch.startswith("*") or branch == "main":
        continue

    p = subprocess.run(["git", "diff", "--quiet", branch])
    if p.returncode == 0:
        LOGGER.info("  Deleting branch: %s", branch)
        subprocess.run(["git", "branch", "-D", branch])


LOGGER.info("Pruning local squash-merged branches.")
current_branch=run_then_split("git rev-parse --abbrev-ref HEAD")[0]
for branch in run_then_split("git for-each-ref refs/heads/ --format=%(refname:short)"):
    ancestor=run_then_split(f"git merge-base {current_branch} {branch}")[0]
    commit=run_then_split("git rev-parse %s^{tree}" % branch)[0]
    temp_tree=run_then_split(f"git commit-tree {commit} -p {ancestor} -m _")[0]
    result=run_then_split(f"git cherry {current_branch} {temp_tree}")[0]
    if result.startswith("-"):
        logging.info("  Deleting branch: %s", branch)
        run_then_split(f"git branch -D {branch}")

LOGGER.info("Pruning remote branches that are merged.")
subprocess.run(["git", "fetch", "--prune", "origin"], check=True)
for branch in run_then_split("git branch -r --merged"):
    if (
        branch.startswith("origin/")
        and not branch.startswith("origin/HEAD")
        and not branch.startswith("origin/main")
        and not branch.startswith("origin/master")
    ):
        branch_name = branch.removeprefix("origin/")
        try:
            subprocess.run(["git", "push", "origin", "--delete", branch_name], check=True)
        except subprocess.CalledProcessError:
            LOGGER.warning("Failed to delete branch %s, skipping...", branch_name)
