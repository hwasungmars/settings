#!/usr/bin/env python3

"""Prune local branches whose remote upstreams have been deleted."""

__author__ = "Hwasung Lee"

import logging
import subprocess

LOGGER = logging.getLogger(__name__)


def run_cmd(cmd: list[str]) -> list[str]:
    """Execute a command and return its stdout."""
    try:
        return subprocess.run(
            cmd, capture_output=True, text=True, check=True
        ).stdout.strip()
    except subprocess.CalledProcessError as e:
        LOGGER.exception(f"Failed running command: {' '.join(cmd)}\n{e.stderr}")
        raise


def worktree_branch_map() -> dict[str, str]:
    """Return {branch_name: worktree_path} for every worktree that has a branch checked out.

    Detached-HEAD worktrees and bare repos are skipped (they have no branch).
    """
    p = subprocess.run(
        ["git", "worktree", "list", "--porcelain"],
        capture_output=True,
        text=True,
        check=True,
    )
    result: dict[str, str] = {}
    current_wt: str | None = None
    for line in p.stdout.splitlines():
        if line.startswith("worktree "):
            current_wt = line[len("worktree ") :]
        elif line.startswith("branch refs/heads/") and current_wt:
            result[line[len("branch refs/heads/") :]] = current_wt
        elif not line:
            current_wt = None
    return result


def try_remove_worktree(branch: str, worktrees: dict[str, str]) -> bool:
    """If `branch` is checked out in a worktree, remove that worktree.

    Returns True if the branch can now be deleted (no worktree in the way), False
    if a worktree exists but couldn't be removed (e.g. uncommitted changes) — in
    which case the caller should skip this branch.
    """
    wt = worktrees.get(branch)
    if wt is None:
        return True
    LOGGER.info("  Removing worktree for %s at %s", branch, wt)
    p = subprocess.run(
        ["git", "worktree", "remove", wt],
        capture_output=True,
        text=True,
    )
    if p.returncode != 0:
        LOGGER.warning(
            "  Failed to remove worktree at %s; skipping branch %s. stderr: %s",
            wt,
            branch,
            p.stderr.strip(),
        )
        return False
    del worktrees[branch]
    return True


def has_remote_ref(branch: str, remote: str = "origin") -> bool:
    """True iff refs/remotes/<remote>/<branch> exists locally."""
    return (
        subprocess.run(
            ["git", "show-ref", "--verify", "--quiet", f"refs/remotes/{remote}/{branch}"],
        ).returncode
        == 0
    )


def squash_merged_into(branch: str, into: str) -> bool:
    """True iff `branch`'s content is already present in `into` as a squash merge.

    Builds a synthetic commit with `branch`'s tree on top of the merge-base, then
    asks `git cherry` whether that commit is already in `into`. The `-` prefix
    means yes (already merged).
    """
    try:
        ancestor = subprocess.run(
            ["git", "merge-base", into, branch],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
        tree = subprocess.run(
            ["git", "rev-parse", f"{branch}^{{tree}}"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
        synthetic = subprocess.run(
            ["git", "commit-tree", tree, "-p", ancestor, "-m", "_"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
        cherry = subprocess.run(
            ["git", "cherry", into, synthetic],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
    except subprocess.CalledProcessError:
        return False
    return cherry.startswith("-")


def main() -> None:
    LOGGER.info("Fetching and pruning remote-tracking branches...")
    run_cmd(["git", "fetch", "--prune"])

    default_branch = run_cmd(["git", "default-branch"])

    LOGGER.info("Scanning for local branches with deleted (merged) remotes...")
    cmd = [
        "git",
        "for-each-ref",
        "--format=%(refname:short)\t%(upstream:short)\t%(upstream:track)",
        "refs/heads/",
    ]
    output = run_cmd(cmd)

    worktrees = worktree_branch_map()

    deleted_count = 0
    for line in output.split("\n"):
        if not line:
            continue

        fields = line.split("\t")
        branch = fields[0]
        upstream = fields[1] if len(fields) > 1 else ""
        tracking_status = fields[2] if len(fields) > 2 else ""

        # Protect main/master branches just in case
        if branch in ["main", "master", default_branch]:
            continue

        # Case 1: upstream config exists and remote was deleted ([gone] marker).
        # Case 2: no upstream config, no remote ref, but content is already in
        # the default branch — covers branches that were pushed without -u,
        # squash-merged on GitHub, and the remote ref pruned by `fetch --prune`.
        gone_with_upstream = "[gone]" in tracking_status
        orphaned_squash_merged = (
            not upstream
            and not has_remote_ref(branch)
            and squash_merged_into(branch, default_branch)
        )
        if not (gone_with_upstream or orphaned_squash_merged):
            continue

        if not try_remove_worktree(branch, worktrees):
            continue
        reason = "[gone]" if gone_with_upstream else "orphaned squash-merge"
        LOGGER.info("  Deleting %s: %s", reason, branch)
        # Force delete (-D) is required because Git doesn't recognize it as officially --merged
        subprocess.run(["git", "branch", "-D", branch], check=True)
        deleted_count += 1

    if deleted_count == 0:
        LOGGER.info("No branches needed pruning.")
    else:
        LOGGER.info(f"Successfully pruned {deleted_count} branches.")


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO, format="%(message)s")
    main()
