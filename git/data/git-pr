#!/usr/bin/env python3

"""Prune local branches whose remote upstreams have been deleted."""

__author__ = "Hwasung Lee"

import logging
import subprocess

LOGGER = logging.getLogger(__name__)


def run_cmd(cmd: list[str]) -> list[str]:
    """Execute a command and return its stdout."""
    try:
        return subprocess.run(
            cmd, capture_output=True, text=True, check=True
        ).stdout.strip()
    except subprocess.CalledProcessError as e:
        LOGGER.exception(f"Failed running command: {' '.join(cmd)}\n{e.stderr}")
        raise


def worktree_branch_map() -> dict[str, str]:
    """Return {branch_name: worktree_path} for every worktree that has a branch checked out.

    Detached-HEAD worktrees and bare repos are skipped (they have no branch).
    """
    p = subprocess.run(
        ["git", "worktree", "list", "--porcelain"],
        capture_output=True,
        text=True,
        check=True,
    )
    result: dict[str, str] = {}
    current_wt: str | None = None
    for line in p.stdout.splitlines():
        if line.startswith("worktree "):
            current_wt = line[len("worktree ") :]
        elif line.startswith("branch refs/heads/") and current_wt:
            result[line[len("branch refs/heads/") :]] = current_wt
        elif not line:
            current_wt = None
    return result


def try_remove_worktree(branch: str, worktrees: dict[str, str]) -> bool:
    """If `branch` is checked out in a worktree, remove that worktree.

    Returns True if the branch can now be deleted (no worktree in the way), False
    if a worktree exists but couldn't be removed (e.g. uncommitted changes) — in
    which case the caller should skip this branch.
    """
    wt = worktrees.get(branch)
    if wt is None:
        return True
    LOGGER.info("  Removing worktree for %s at %s", branch, wt)
    p = subprocess.run(
        ["git", "worktree", "remove", wt],
        capture_output=True,
        text=True,
    )
    if p.returncode != 0:
        LOGGER.warning(
            "  Failed to remove worktree at %s; skipping branch %s. stderr: %s",
            wt,
            branch,
            p.stderr.strip(),
        )
        return False
    del worktrees[branch]
    return True


def main() -> None:
    LOGGER.info("Fetching and pruning remote-tracking branches...")
    run_cmd(["git", "fetch", "--prune"])

    LOGGER.info("Scanning for local branches with deleted (merged) remotes...")
    cmd = [
        "git",
        "for-each-ref",
        "--format=%(refname:short) %(upstream:track)",
        "refs/heads/",
    ]
    output = run_cmd(cmd)

    worktrees = worktree_branch_map()

    deleted_count = 0
    for line in output.split("\n"):
        if not line:
            continue

        parts = line.split(" ", 1)
        branch = parts[0]
        tracking_status = parts[1] if len(parts) > 1 else ""

        # Protect main/master branches just in case
        if branch in ["main", "master"]:
            continue

        # If the remote branch was deleted (squash-merged on GitHub), it will say [gone]
        if "[gone]" in tracking_status:
            if not try_remove_worktree(branch, worktrees):
                continue
            # Force delete (-D) is required because Git doesn't recognize it as officially --merged
            subprocess.run(["git", "branch", "-D", branch], check=True)
            deleted_count += 1

    if deleted_count == 0:
        LOGGER.info("No branches needed pruning.")
    else:
        LOGGER.info(f"Successfully pruned {deleted_count} branches.")


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO, format="%(message)s")
    main()
